##PROJECT SETTINGS VARIABLES##
# Theme, product name, sign-in buttons, Calendly and GA are defaults: an admin can
# override them at runtime in /admin/settings (stored in the database).
NEXT_PUBLIC_THEME=
NEXT_PUBLIC_SAAS_NAME=
NEXT_PUBLIC_SITE_DESCRIPTION=
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_URL="http://localhost:3000"
NEXT_PUBLIC_THEME_TYPE="dark"

##LANDING MODULE VARIABLES##
NEXT_PUBLIC_CMS="postgres"

##AUTHENTICATION MODULE VARIABLES##
NEXT_PUBLIC_AUTH_FRAMEWORK="better-auth"
NEXT_PUBLIC_AUTH_EMAIL=true
NEXT_PUBLIC_AUTH_GOOGLE=false
NEXT_PUBLIC_AUTH_GITHUB=false
NEXT_PUBLIC_AUTH_LINKEDIN=false
BETTER_AUTH_SECRET=
AUTH_LINKEDIN_CLIENT_ID=
AUTH_LINKEDIN_CLIENT_SECRET=
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
# Demo (read-only guest) one-click login. Server-only — do not prefix with
# NEXT_PUBLIC_. Used both by an admin creating the demo guest account (via
# Admin > Users > Create Guest) and by /api/demo-login to sign into it.
DEMO_GUEST_EMAIL=
DEMO_GUEST_PASSWORD=

##SUPPORT MODULE VARIABLES##
NEXT_PUBLIC_SUPPORT_MAIL=
NEXT_PUBLIC_CALENDLY_BOOKING_URL=
NEXT_PUBLIC_EMAIL_CLIENT="none"

##STORAGE MODULE VARIABLES##
NEXT_PUBLIC_IMAGE_STORAGE="vercel_blob"
# scaffold:begin image_storage.vercel_blob
BLOB_READ_WRITE_TOKEN=
# scaffold:end image_storage.vercel_blob
# scaffold:begin image_storage.cloudflare_r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
NEXT_PUBLIC_R2_PUBLIC_URL=
# scaffold:end image_storage.cloudflare_r2
# DATABASE_URL: Postgres URL used by the app runtime and the Prisma CLI
# (migrate/seed/generate). Always postgresql://...
DATABASE_URL=
PRISMA_QUERY_LOGGING=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

##OBSERVABILITY MODULE VARIABLES##
NEXT_PUBLIC_ALLOW_RATE_LIMIT="upstash"
BETTERSTACK_TELEMETRY_SOURCE_TOKEN=
BETTERSTACK_TELEMETRY_INGESTING_HOST=
NEXT_PUBLIC_GOOGLE_ANALYTICS_MEASUREMENT_ID=
GA4_PROPERTY_ID=
GA4_CREDENTIALS_JSON=
GOOGLE_PAGESPEED_API_KEY=


# scaffold:begin billing
##PAYMENT MODULE VARIABLES##
NEXT_PUBLIC_PAYMENT_GATEWAY=
# scaffold:begin payment_gateway.dodo
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_RETURN_URL=
DODO_PAYMENTS_ENVIRONMENT=
DODO_CREDITS_PRODUCT_ID=
NEXT_PUBLIC_DODO_PAYMENTS_URL=
# scaffold:end payment_gateway.dodo
# scaffold:begin payment_gateway.stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# scaffold:end payment_gateway.stripe
# scaffold:end billing

# scaffold:begin ai
## AI MODULE VARIABLES##
NEXT_PUBLIC_AI_ENABLED=false
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=
OPENAI_COMPATIBLE_BASE_URL=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_JWT_KEY=
# scaffold:end ai

# scaffold:begin jobs
## BACKGROUND JOBS ##
# "inngest" queues jobs and runs cron schedules on Inngest; anything else runs jobs inline.
JOBS_DRIVER=inline
# From Inngest Cloud, or the keys a self-hosted Inngest server was started with.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# A self-hosted server, e.g. http://localhost:8288. Empty for Inngest Cloud.
INNGEST_BASE_URL=
# The URL Inngest calls back (this app), when it differs from the request origin.
INNGEST_SERVE_ORIGIN=
# 1 in local development: talk to the dev server, skip signature checks.
INNGEST_DEV=
# scaffold:end jobs

# scaffold:begin webhooks
## OUTGOING WEBHOOKS ##
# Encrypts endpoint signing secrets at rest: `openssl rand -base64 32`. Changing it makes stored secrets unreadable.
WEBHOOK_SECRET_KEY=
# scaffold:end webhooks

# scaffold:begin ai_agents
## BACKEND SERVICE VARIABLES ##
BACKEND_URL=http://localhost:8000
BACKEND_HMAC_SECRET=dev-only-change-me-32bytes-hex0000
# scaffold:end ai_agents
