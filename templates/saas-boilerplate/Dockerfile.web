# syntax=docker/dockerfile:1

FROM node:24-bookworm-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates openssl \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable \
  && corepack prepare pnpm@10.4.1 --activate

FROM base AS pruner
RUN pnpm add --global turbo@2.7.4
COPY . .
RUN turbo prune web --docker \
  && mkdir -p /scaffold-runtime \
  && for asset in scaffold-modules scaffold-providers template-sync.manifest.json releases templates/saas-boilerplate; do \
    if [ -e "$asset" ]; then cp -a --parents "$asset" /scaffold-runtime/ || exit 1; fi; \
  done

FROM base AS installer
COPY --from=pruner /app/out/json/ .
RUN pnpm install --frozen-lockfile
COPY --from=pruner /app/out/full/ .
# Turbo only retains workspace packages. The root app also reads scaffold data;
# a downloaded starter has none of these optional platform-only assets.
COPY --from=pruner /scaffold-runtime/ .
RUN pnpm --dir packages/database generate
RUN pnpm turbo build --filter=web...

FROM base AS runner
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
WORKDIR /app

RUN groupadd --system --gid 1001 nodejs \
  && useradd --system --uid 1001 --gid nodejs nextjs

COPY --from=installer --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=installer --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=installer --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public
# Copy complete starter sources, including files outside Next's tracing globs.
COPY --from=pruner --chown=nextjs:nodejs /scaffold-runtime/ ./

USER nextjs
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
